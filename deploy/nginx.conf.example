# Example nginx — FE + BE subpaths (no per-store containers)
upstream lnsms_fe {
  server 127.0.0.1:63001;
}
upstream lnsms_be {
  server 127.0.0.1:40000;
}

server {
  listen 80;
  server_name example.com;

  location /api/ {
    proxy_pass http://lnsms_be;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 500m;
  }

  location /uploads/ {
    proxy_pass http://lnsms_be;
  }

  location /health {
    proxy_pass http://lnsms_be;
  }

  # Platform UI + Store site UI + legacy redirects
  location / {
    proxy_pass http://lnsms_fe;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
